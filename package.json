		"chokidar": "5.0.0",
		"electron-log": "5.4.4",
		"electron-updater": "6.8.9",
		"node-pty": "1.1.0",
		"simple-git": "3.36.0",
		"typescript": "6.0.3",
		"typescript-language-server": "6.0.1",
		"zod": "4.6.5"
	},
